# =============================================================================
# Astro-Stack — Environment Variables Example
# Copy to .env and edit before running docker compose up
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Astro-Stack
LOG_LEVEL=info                   # debug | info | warning | error

# ── Authentication ────────────────────────────────────────────────────────────
# AUTH_MODE controls authentication strategy:
#   disabled  → all auth bypassed (development default)
#   mock      → HS256 JWT / X-Mock-User header bridge (staging)
#   oidc      → full OAuth 2.1 / OIDC via AuthService (production)
AUTH_MODE=disabled

# OIDC settings (required when AUTH_MODE=oidc)
OIDC_ISSUER=https://auth.astromote.com
OIDC_AUDIENCE=astrostack
OIDC_JWKS_CACHE_TTL_SECONDS=3600
OIDC_ADMIN_ROLE=admin

# CORS — comma-separated list of allowed origins (use * for open APIs)
CORS_ALLOWED_ORIGINS=https://app.astromote.com

# Legacy — only used when AUTH_MODE=mock
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production-min-16-chars

# ── Database ───────────────────────────────────────────────────────────────────
# Uses embedded postgres container by default
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro
POSTGRES_DB=astrostack

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ── Storage paths (host paths mapped into containers) ─────────────────────────
INBOX_HOST_PATH=./data/inbox        # Drop session folders here
SESSIONS_HOST_PATH=./data/sessions  # Intermediate processing files
OUTPUT_HOST_PATH=./data/output      # Final processed images
MODELS_HOST_PATH=./data/models      # AI model weight files (.pth)

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8080
UI_PORT=3000                        # Direct astro-ui access (no reverse proxy)

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_MAX_RETRIES=3
SESSION_STABILITY_DELAY=30.0        # Seconds before considering a session ready

# ── GPU ───────────────────────────────────────────────────────────────────────
# Worker GPU assignments are fixed per container in docker-compose.yml
# astro-worker-gpu0 → GPU 0 (CUDA_VISIBLE_DEVICES=0)
# astro-worker-gpu1 → GPU 1 (CUDA_VISIBLE_DEVICES=1)
GPU_DEVICES=0,1

# ── Traefik Reverse Proxy (optional — docker compose --profile traefik up) ────
# Not required for a standard deployment: astro-api/astro-ui already publish
# API_PORT/UI_PORT directly above. Enable this profile only if you don't
# already run a reverse proxy in front of this host.
TRAEFIK_HOST=astro.localhost                  # Domain for the API
TRAEFIK_DASHBOARD_HOST=traefik.localhost       # Traefik dashboard domain
TRAEFIK_ACME_EMAIL=admin@example.com          # Let's Encrypt email
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8081

# ── SearXNG (optional — docker compose --profile searxng up) ─────────────────
# Self-hosted meta-search backing the planned reference-image search feature
# of the Phase 2 adaptive critic. Not consumed by the application yet.
SEARXNG_PORT=8888

# ── vLLM adaptive critic (optional) ──────────────────────────────────────────
# Points at an OpenAI-compatible chat/completions endpoint (e.g. a self-hosted
# vLLM server). Only used when a profile enables `adaptive_critic_enabled` or
# `live_adaptive_critic_enabled` — the core pipeline never depends on this
# being reachable. Not started by this compose file; point it at an existing
# vLLM deployment.
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=lagarde-vllm
VLLM_API_KEY=
